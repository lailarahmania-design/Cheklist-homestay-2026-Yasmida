{
  "name": "jejak-cahaya",
  "version": "0.1.0",
  "description": "Jejak Cahaya \u2014 The Last Journey: game petualangan edukatif untuk ujian akhir bab berkelompok",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
