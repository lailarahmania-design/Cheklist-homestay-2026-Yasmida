    "test:e2e": "node tests/e2e/app.e2e.cjs",
    "build:single": "vite build --config vite.single.config.js && node tools/build-single.mjs"
  },
  "devDependencies": {
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
